# bin/ovx setup generates private local authentication tokens.
OVX_WORKSPACE_ROOT=${OVX_INSTALL_ROOT}/.ovx/workspaces
# Colon-separated allowed source-repository directories.
OVX_REPOSITORY_ROOTS=
OVX_API_URL=http://127.0.0.1:3000
OVX_API_TOKEN=
OVX_RUNTIME_URL=http://127.0.0.1:7070
OVX_RUNTIME_ADDR=127.0.0.1:7070
OVX_RUNTIME_TOKEN=
OVX_SANDBOX_IMAGE=ovx-sandbox-demo-rails:latest
OVX_MAX_FILE_BYTES=200000
OVX_MAX_TOOL_OUTPUT_BYTES=200000
OVX_COMMAND_TIMEOUT_SECONDS=300
# mock is the deterministic calculator demo, not a coding model.
MODEL_PROVIDER=mock
MODEL_BASE_URL=http://127.0.0.1:8080/v1
MODEL_NAME=ovx-local
MODEL_API_KEY=
MODEL_JSON_MODE=true
MODEL_TIMEOUT_SECONDS=300
MODEL_PATH=
MODEL_CONTEXT_SIZE=8192
MODEL_CONTEXT_BYTES=18000
MODEL_MAX_TOKENS=1800
OVX_POSTGRES_PORT=55432
OVX_REDIS_PORT=56379
DATABASE_URL=postgres://ovx:ovx@127.0.0.1:55432/ovx_development
TEST_DATABASE_URL=postgres://ovx:ovx@127.0.0.1:55432/ovx_test
REDIS_URL=redis://127.0.0.1:56379/0
SECRET_KEY_BASE=
