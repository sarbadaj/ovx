#!/usr/bin/env python3
"""Verify the real model with a fresh disposable Rails/RSpec repository."""
import sys,json,subprocess,time
from pathlib import Path
import ovx_cli as c
c.initialize()
env=c.load_env()
(c.STATE / "validation").mkdir(exist_ok=True)
if env.get("MODEL_PROVIDER") != "openai_compatible":
    raise RuntimeError("Run bin/ovx setup-model and bin/ovx restart first")
target=c.demo(env,'demo-rails')
original=(target/'app/controllers/calculations_controller.rb').read_bytes()
spec=(target/'spec/requests/calculations_spec.rb').read_bytes()
baseline=subprocess.run(['docker','run','--rm','--network','none','-e','RAILS_ENV=test','-v',str(target)+':/workspace','-w','/workspace',env['OVX_SANDBOX_IMAGE'],'bundle','exec','rspec'],env=env,text=True,capture_output=True)
print('Baseline exit:',baseline.returncode,flush=True)
print(baseline.stdout[-2500:],flush=True)
if baseline.returncode==0 or '1 example, 1 failure' not in baseline.stdout: raise RuntimeError('Fixture baseline is not the intended failing spec: '+baseline.stderr)
repo=c.request(env,'/api/repositories',{'path':str(target)})
task=c.request(env,'/api/tasks',{'repository_id':repo['id'],'request':'Fix the failing RSpec request test in spec/requests/calculations_spec.rb. Read the spec and app/controllers/calculations_controller.rb. Keep the JSON API unchanged and do not modify tests. Run bundle exec rspec and inspect git_diff after the fix.'})
(c.STATE/'validation/rails-task.json').write_text(json.dumps({'task_id':task['id'],'source':str(target),'repository_id':repo['id']}))
print('Real model task:',task['id'],'source:',target,flush=True)
task=c.wait_task(env,task['id'],900)
if task['state']!='completed':
 print(json.dumps(task,indent=2));raise RuntimeError('Task did not complete')
assert (target/'app/controllers/calculations_controller.rb').read_bytes()==original,'source changed before acceptance'
review=c.request(env,f"/api/tasks/{task['id']}/diff")
assert [f['path'] for f in review['files']]==['app/controllers/calculations_controller.rb'],review
print('Verified isolated diff:',review['diff'],flush=True)
result=c.request(env,f"/api/tasks/{task['id']}/apply_result",{'expected_patch_sha256':review['patch_sha256']})
assert result['resolution']=='accepted'
assert (target/'spec/requests/calculations_spec.rb').read_bytes()==spec
accepted=subprocess.run(['docker','run','--rm','--network','none','-e','RAILS_ENV=test','-v',str(target)+':/workspace','-w','/workspace',env['OVX_SANDBOX_IMAGE'],'bundle','exec','rspec'],env=env,text=True,capture_output=True)
print(accepted.stdout,flush=True)
assert accepted.returncode==0,accepted.stderr
report={'passed':True,'provider':env['MODEL_PROVIDER'],'model_path':env['MODEL_PATH'],'task_id':task['id'],'source':str(target),'test_output':accepted.stdout,'diff':review['diff'],'source_unchanged_before_accept':True,'tests_unchanged':True}
(c.STATE/'validation/rails-e2e-result.json').write_text(json.dumps(report,indent=2))
print('OVX REAL MODEL RAILS E2E PASSED',flush=True)
